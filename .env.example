# Copy this file to `.env.local` and fill in the values.

# --- Admin dashboard (/admin) ----------------------------------------------
# Password required to open the admin dashboard.
ADMIN_PASSWORD=change-this-password
# Optional: any long random string. Used to sign admin sessions and upload links.
SESSION_SECRET=

# --- Uploads -----------------------------------------------------------------
# Maximum size of a proof PDF in MB (the Google Form allowed 100 MB).
# Supabase's free plan caps single files at 50 MB, so use 50 there.
MAX_UPLOAD_MB=100

# --- Local mode (default) ------------------------------------------------------
# Folder where the SQLite database and uploaded PDFs are stored.
DATA_DIR=./data

# --- Cloud mode (Vercel + Supabase) ----------------------------------------------
# Fill in both values to switch the app to Supabase automatically.
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for the proof PDFs (created by supabase/schema.sql).
SUPABASE_BUCKET=proofs
